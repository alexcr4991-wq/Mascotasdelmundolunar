# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WOMPI PAYMENT GATEWAY CONFIGURATION (Colombia)
# WOMPI_ENVIRONMENT: 'sandbox' for testing without real money, 'production' for real transactions
WOMPI_ENVIRONMENT=sandbox

# WOMPI_PUBLIC_KEY: Public merchant key (starts with pub_test_ or pub_prod_)
WOMPI_PUBLIC_KEY=

# WOMPI_PRIVATE_KEY: Private merchant key (kept strictly on server, starts with prv_test_ or prv_prod_)
WOMPI_PRIVATE_KEY=

# WOMPI_INTEGRITY_SECRET: Secret used to generate SHA-256 integrity signatures on the backend
WOMPI_INTEGRITY_SECRET=

# WOMPI_EVENTS_SECRET: Secret used to validate Webhook event checksums from Wompi
WOMPI_EVENTS_SECRET=
